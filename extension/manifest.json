{
  "manifest_version": 3,
  "name": "VerifAI — Fact-check Selection",
  "version": "1.0.1",
  "description": "Fact-check selected text and webpages using VerifAI.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VerifAI"
  }
}
