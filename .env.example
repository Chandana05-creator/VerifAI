# VerifAI settings — copy this file to ".env" (setup.bat does it for you) and fill in the two keys.
# No quotes and no spaces around the = sign.

GEMINI_API_KEY=
TAVILY_API_KEY=

# Models: run  python list_models.py  (in the backend folder) to see which your key can use.
GEMINI_MODEL_STRONG=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# Optional — leave these out unless you know you need them:
# DATABASE_URL=postgresql+asyncpg://verifai:verifai@localhost:5432/verifai
# MAX_CLAIMS=5
# JWT_SECRET=replace-with-a-long-random-string
# ENABLE_CRITIC=true          # the Critic agent (deep mode) searches for evidence against each strong claim
# CRITIC_MAX_CLAIMS=3         # claims challenged per run
# RUNS_PER_MINUTE=8           # per-IP limit on runs, protects your API quota
# MAX_UPLOAD_MB=5             # largest image accepted
